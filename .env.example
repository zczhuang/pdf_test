# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud — path to your Service Account JSON key file
# See README for how to create one
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# YouTube Data API v3 (optional — for link enrichment)
# Get one free at console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Google Drive folder ID — the ID of a shared folder for your journal
# Create a folder in Drive, share it with your service account email, copy its ID from the URL
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Flask secret key (any random string)
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Optional: set to "production" when deploying
FLASK_ENV=development
