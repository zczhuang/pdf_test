# Gemini Developer API
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model
GEMINI_MODEL=gemini-2.5-flash-lite

# Browser login — use a Google OAuth Web application client
# Authorized redirect URI: https://YOUR_PUBLIC_URL/auth/callback
GOOGLE_OIDC_CLIENT_ID=your_google_oidc_web_client_id_here
GOOGLE_OIDC_CLIENT_SECRET=your_google_oidc_web_client_secret_here
ALLOWED_GOOGLE_EMAILS=your.email@gmail.com
PUBLIC_BASE_URL=https://your-public-journalpal-url.run.app

# OpenAI API — used for voice transcription via gpt-4o-mini-transcribe
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud — path to your Service Account JSON key file
# See README for how to create one
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Optional: Google Photos Picker refresh token
# Scope: https://www.googleapis.com/auth/photospicker.mediaitems.readonly
GOOGLE_PHOTOS_REFRESH_TOKEN=your_google_photos_refresh_token_here

# YouTube Data API v3 (optional — for link enrichment)
# Get one free at console.cloud.google.com → APIs & Services → Credentials
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Google Drive folder ID — the ID of a shared folder for your journal
# Create a folder in Drive, share it with your service account email, copy its ID from the URL
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Flask secret key (any random string)
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Optional: set to "production" when deploying
FLASK_ENV=development
